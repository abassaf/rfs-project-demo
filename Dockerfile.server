FROM node:20-alpine
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
COPY client/package.json ./client/
COPY server/package.json ./server/
COPY shared ./shared/

# Install all dependencies (client + server) so both can be built
RUN pnpm install --frozen-lockfile

COPY client ./client/
COPY server ./server/

# Build client first so Express can serve the static files
ENV VITE_API_URL=""
RUN pnpm --filter client build

RUN pnpm --filter server build

WORKDIR /app/server
EXPOSE 3001
CMD ["npm", "run", "start"]
